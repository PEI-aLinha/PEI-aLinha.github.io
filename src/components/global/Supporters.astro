---
import { url } from '../../lib/paths';

/* Logos are exported at 128px tall (2x the rendered height); width keeps
   each file's own aspect ratio so nothing shifts while they load. */
const supporters = [
    { name: 'Universidade de Aveiro', src: '/images/logos/ua.png', width: 345, href: 'https://www.ua.pt' },
    { name: 'IEETA', src: '/images/logos/ieeta.png', width: 287, href: 'https://www.ieeta.pt' },
    { name: 'LASI — Laboratório Associado de Sistemas Inteligentes', src: '/images/logos/lasi.png', width: 192 },
    { name: 'AETTUA — Associação de Eletrónica, Telecomunicações e Telemática da UA', src: '/images/logos/aettua.png', width: 486 },
];
---
<section aria-labelledby="supporters-heading" class="border-t border-line">
    <div class="shell rail-grid items-center py-12">
        <h2 id="supporters-heading" class="meta">Supported by</h2>
        <ul class="flex flex-wrap items-center gap-x-14 gap-y-8">
            {
                supporters.map((s) => {
                    const Tag = s.href ? 'a' : 'span';
                    return (
                        <li>
                            <Tag
                                    href={s.href}
                                    rel={s.href ? 'noopener noreferrer' : undefined}
                                    target={s.href ? '_blank' : undefined}
                                    class="block opacity-85 transition-opacity duration-300 hover:opacity-100"
                            >
                                <img
                                        src={url(s.src)}
                                        alt={s.name}
                                        width={s.width}
                                        height="128"
                                        loading="lazy"
                                        class="h-10 w-auto md:h-12"
                                />
                            </Tag>
                        </li>
                    );
                })
            }
        </ul>
    </div>
</section>
