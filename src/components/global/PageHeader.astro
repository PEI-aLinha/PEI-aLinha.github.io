---
interface Props {
    label: string;
    title: string;
    lead?: string
    id?: string;
}

const { label, title, lead, id = 'page-heading' } = Astro.props;

---

<div class="shell rail-grid pt-16 pb-16 md:pt-26">
    <div>
        <p class="meta">{label}</p>
    </div>
    <div>
        <h1 id = {id}
            data-reveal
            class="max-w-4xl font-display font-semibold tracking-[-0.045em]"
            style="font-size: var(--text-title); line-height: 1;"
            >
            {title}
        </h1>
        {
            lead && (
                <p class="mt-7 max-w-xl text-[1.0625rem] leading-relaxed text-muted!" data-reveal style="transition-delay: 100ms">
                    {lead}
                </p>
            )
        }
        <slot />
    </div>
</div>