---
import Logo from '../ui/Logo.astro';
import ThemeToggle from '../ui/ThemeToggle.astro';

const links = [
  { label: 'Project', href: '/project' },
  { label: 'Minutes', href: '/minutes' },
  { label: 'Progress', href: '/milestones' },
  { label: 'Team', href: '/team' },
  { label: 'Documentation', href: '/documentation' },
];

const repo = 'https://github.com/PEI-aLinha/';
const base = import.meta.env.BASE_URL.replace(/\/$/, '');
const currentPath = Astro.url.pathname.replace(/\/$/, '') || '/';
const url = (path: string) => `${base}${path === '/' ? '/' : path}`;
const isActive = (path: string) => {
  const target = url(path).replace(/\/$/, '') || '/';
  return currentPath === target || (target !== '/' && currentPath.startsWith(`${target}/`));
};
---
<header class="border-b border-line bg-background/95 backdrop-blur-sm">
  <nav aria-label="Main" class="shell flex h-[4.5rem] items-center gap-14 md:h-24">
    <a href={url('/')} class="text-2xl text-brand" aria-label="aLinha — home"><Logo /></a>

    <div class="hidden flex-1 items-center gap-9 md:flex">
      {links.map((link) => (
        <a href={url(link.href)} aria-current={isActive(link.href) ? 'page' : undefined} class="nav-link relative py-2 text-sm">
          {link.label}
        </a>
      ))}
    </div>

    <div class="ml-auto hidden text-brand md:block"><ThemeToggle /></div>

    <a href={repo} rel="noopener noreferrer" target="_blank" aria-label="GitHub — opens in a new tab" class="github-link ml-4 hidden h-9 w-9 items-center justify-center text-brand transition-opacity duration-300 hover:opacity-70 md:flex">
      <svg viewBox="0 0 24 24" class="h-4 w-4" fill="currentColor" aria-hidden="true"><path d="M12 .5C5.65.5.5 5.65.5 12c0 5.09 3.29 9.4 7.86 10.93.57.1.78-.25.78-.55 0-.27-.01-1.17-.02-2.12-3.2.7-3.88-1.36-3.88-1.36-.52-1.34-1.28-1.69-1.28-1.69-1.05-.72.08-.7.08-.7 1.16.08 1.77 1.19 1.77 1.19 1.03 1.77 2.7 1.26 3.36.96.1-.75.4-1.26.73-1.55-2.55-.29-5.24-1.28-5.24-5.69 0-1.26.45-2.28 1.19-3.09-.12-.29-.52-1.47.11-3.06 0 0 .97-.31 3.18 1.18a11.03 11.03 0 0 1 5.8 0c2.2-1.49 3.17-1.18 3.17-1.18.64 1.59.24 2.77.12 3.06.74.81 1.18 1.83 1.18 3.09 0 4.42-2.69 5.39-5.25 5.68.41.36.78 1.06.78 2.14 0 1.55-.01 2.79-.01 3.17 0 .3.2.66.79.55A10.52 10.52 0 0 0 23.5 12c0-6.35-5.15-11.5-11.5-11.5Z" /></svg>
    </a>

    <button type="button" id="nav-toggle" aria-expanded="false" aria-controls="nav-panel" class="ml-auto flex h-11 w-11 flex-col items-end justify-center gap-1.5 md:hidden">
      <span class="sr-only">Menu</span><span class="block h-px w-6 bg-text" aria-hidden="true"></span><span class="block h-px w-4 bg-brand" aria-hidden="true"></span>
    </button>
  </nav>
</header>

<div id="nav-panel" hidden class="fixed inset-0 top-[4.5rem] z-40 flex flex-col bg-brand-deep pb-10 text-white md:hidden">
    <div class="shell flex flex-1 flex-col overflow-y-auto pt-10">
      <p class="meta text-white/60">Menu</p>
      <div class="mt-6 flex flex-col">
        {links.map((link) => (
          <a href={url(link.href)} aria-current={isActive(link.href) ? 'page' : undefined} class="flex min-h-16 items-center border-b border-white/20 font-display text-4xl font-medium tracking-[-0.03em]">
            {link.label}
          </a>
        ))}
      </div>
      <div class="mt-auto flex items-center gap-6 pt-10">
        <div class="flex h-12 w-12 items-center justify-center border border-white/35"><ThemeToggle /></div>
        <a href={repo} rel="noopener noreferrer" target="_blank" aria-label="GitHub — opens in a new tab" class="github-link flex h-9 w-9 items-center justify-center border border-white/35">
          <svg viewBox="0 0 24 24" class="h-5 w-5" fill="currentColor" aria-hidden="true"><path d="M12 .5C5.65.5.5 5.65.5 12c0 5.09 3.29 9.4 7.86 10.93.57.1.78-.25.78-.55 0-.27-.01-1.17-.02-2.12-3.2.7-3.88-1.36-3.88-1.36-.52-1.34-1.28-1.69-1.28-1.69-1.05-.72.08-.7.08-.7 1.16.08 1.77 1.19 1.77 1.19 1.03 1.77 2.7 1.26 3.36.96.1-.75.4-1.26.73-1.55-2.55-.29-5.24-1.28-5.24-5.69 0-1.26.45-2.28 1.19-3.09-.12-.29-.52-1.47.11-3.06 0 0 .97-.31 3.18 1.18a11.03 11.03 0 0 1 5.8 0c2.2-1.49 3.17-1.18 3.17-1.18.64 1.59.24 2.77.12 3.06.74.81 1.18 1.83 1.18 3.09 0 4.42-2.69 5.39-5.25 5.68.41.36.78 1.06.78 2.14 0 1.55-.01 2.79-.01 3.17 0 .3.2.66.79.55A10.52 10.52 0 0 0 23.5 12c0-6.35-5.15-11.5-11.5-11.5Z" /></svg>
        </a>
      </div>
    </div>
  </div>

<style>
  .nav-link::after { content:''; position:absolute; left:0; right:100%; bottom:-1px; height:2px; background:var(--color-brand); transition:right 260ms var(--ease-align); }
  .nav-link:hover::after, .nav-link:focus-visible::after, .nav-link[aria-current]::after { right:0; }
  .nav-link[aria-current] { color:var(--color-brand); }
  .github-link svg { width: 1.5rem; height: 1.5rem; }
</style>

<script is:inline>
  const toggle = document.getElementById('nav-toggle');
  const panel = document.getElementById('nav-panel');
  const closeMenu = () => { toggle?.setAttribute('aria-expanded','false'); panel?.setAttribute('hidden',''); };
  toggle?.addEventListener('click', () => { const open = toggle.getAttribute('aria-expanded') === 'true'; toggle.setAttribute('aria-expanded', String(!open)); panel?.toggleAttribute('hidden', open); });
  panel?.addEventListener('click', (event) => { if (event.target instanceof Element && event.target.closest('a')) closeMenu(); });
  document.addEventListener('keydown', (event) => { if (event.key === 'Escape' && toggle?.getAttribute('aria-expanded') === 'true') { closeMenu(); toggle.focus(); } });
</script>
