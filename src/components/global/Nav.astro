---
import Logo from '../ui/Logo.astro';

const links = [
    { label: 'Project', href: '/project' },
    { label: 'Progress', href: '/milestones' },
    { label: 'Team', href: '/team' },
    { label: 'Minutes', href: '/minutes' },
    { label: 'Documentation', href: '/documentation' },
];

const repo = 'https://github.com/pei-alinha/';
const base = import.meta.env.BASE_URL.replace(/\/$/, '');
const currentPath = Astro.url.pathname.replace(/\/$/, '') || '/';

const url = (path: string) => `${base}${path === '/' ? '/' : path}`;
const isActive = (path: string) => {
    const target = url(path).replace(/\/$/, '') || '/';
    return currentPath === target || (target !== '/' && currentPath.startsWith(`${target}/`));
};
---
<header class="border-b border-line">
    <nav aria-label="Main" class="shell flex h-16 items-center gap-14 md:h-22">
        <a href={url('/')} class="text-2xl" aria-label="aLinha — home"><Logo /></a>

        <div class="hidden flex-1 items-center gap-9 md:flex">
            {
                links.map((link) => (
                        <a
                                href={url(link.href)}
                                aria-current={isActive(link.href) ? 'page' : undefined}
                                class="axis-link text-sm"
                        >
                            {link.label}
                        </a>
                ))
            }
        </div>

        <a
                href={repo}
                rel="noopener noreferrer"
                target="_blank"
                aria-label="GitHub — opens in a new tab"
                class="ml-auto hidden h-9 w-9 items-center justify-center border border-line text-text opacity-85 transition-opacity duration-300 hover:opacity-100 md:flex"
        >
            <svg viewBox="0 0 24 24" class="h-5 w-5" fill="currentColor" aria-hidden="true">
                <path d="M12 .5C5.65.5.5 5.65.5 12c0 5.09 3.29 9.4 7.86 10.93.57.1.78-.25.78-.55 0-.27-.01-1.17-.02-2.12-3.2.7-3.88-1.36-3.88-1.36-.52-1.34-1.28-1.69-1.28-1.69-1.05-.72.08-.7.08-.7 1.16.08 1.77 1.19 1.77 1.19 1.03 1.77 2.7 1.26 3.36.96.1-.75.4-1.26.73-1.55-2.55-.29-5.24-1.28-5.24-5.69 0-1.26.45-2.28 1.19-3.09-.12-.29-.52-1.47.11-3.06 0 0 .97-.31 3.18 1.18a11.03 11.03 0 0 1 5.8 0c2.2-1.49 3.17-1.18 3.17-1.18.64 1.59.24 2.77.12 3.06.74.81 1.18 1.83 1.18 3.09 0 4.42-2.69 5.39-5.25 5.68.41.36.78 1.06.78 2.14 0 1.55-.01 2.79-.01 3.17 0 .3.2.66.79.55A10.52 10.52 0 0 0 23.5 12c0-6.35-5.15-11.5-11.5-11.5Z" />
            </svg>
        </a>

        <button
                type="button"
                id="theme-toggle"
                aria-label="Toggle color theme"
                class="ml-6 hidden h-9 w-9 items-center justify-center border border-line text-text md:flex"
        >
            <span id="theme-toggle-icon" aria-hidden="true">◐</span>
        </button>

        <button
                type="button"
                id="nav-toggle"
                aria-expanded="false"
                aria-controls="nav-panel"
                class="ml-auto flex h-11 w-11 flex-col items-end justify-center gap-1.5 md:hidden"
        >
            <span class="sr-only">Menu</span>
            <span class="block h-px w-6 bg-text" aria-hidden="true"></span>
            <span class="block h-px w-4 bg-text" aria-hidden="true"></span>
        </button>
    </nav>

    <div id="nav-panel" hidden class="shell border-t border-line pb-10 md:hidden">
        <p class="meta pt-8">Menu</p>
        <div class="mt-6 flex flex-col">
            {
                links.map((link) => (
                        <a
                                href={url(link.href)}
                                aria-current={isActive(link.href) ? 'page' : undefined}
                                class="flex min-h-15 items-center border-b border-line font-display text-3xl font-medium tracking-[-0.03em]"
                        >
                            {link.label}
                        </a>
                ))
            }
        </div>
        <div class="mt-7 flex items-center gap-6">
            <a
                    href={repo}
                    rel="noopener noreferrer"
                    target="_blank"
                    aria-label="GitHub — opens in a new tab"
                    class="flex h-9 w-9 items-center justify-center border border-line text-text"
            >
                <svg viewBox="0 0 24 24" class="h-5 w-5" fill="currentColor" aria-hidden="true">
                    <path d="M12 .5C5.65.5.5 5.65.5 12c0 5.09 3.29 9.4 7.86 10.93.57.1.78-.25.78-.55 0-.27-.01-1.17-.02-2.12-3.2.7-3.88-1.36-3.88-1.36-.52-1.34-1.28-1.69-1.28-1.69-1.05-.72.08-.7.08-.7 1.16.08 1.77 1.19 1.77 1.19 1.03 1.77 2.7 1.26 3.36.96.1-.75.4-1.26.73-1.55-2.55-.29-5.24-1.28-5.24-5.69 0-1.26.45-2.28 1.19-3.09-.12-.29-.52-1.47.11-3.06 0 0 .97-.31 3.18 1.18a11.03 11.03 0 0 1 5.8 0c2.2-1.49 3.17-1.18 3.17-1.18.64 1.59.24 2.77.12 3.06.74.81 1.18 1.83 1.18 3.09 0 4.42-2.69 5.39-5.25 5.68.41.36.78 1.06.78 2.14 0 1.55-.01 2.79-.01 3.17 0 .3.2.66.79.55A10.52 10.52 0 0 0 23.5 12c0-6.35-5.15-11.5-11.5-11.5Z" />
                </svg>
            </a>
            <button
                    type="button"
                    id="theme-toggle-mobile"
                    aria-label="Toggle color theme"
                    class="flex h-9 w-9 items-center justify-center border border-line text-text"
            >
                <span id="theme-toggle-icon-mobile" aria-hidden="true">◐</span>
            </button>
        </div>
    </div>
</header>

<script>
    const toggle = document.getElementById('nav-toggle') as HTMLButtonElement | null;
    const panel = document.getElementById('nav-panel');

    const closeMenu = () => {
        toggle?.setAttribute('aria-expanded', 'false');
        panel?.setAttribute('hidden', '');
    };

    toggle?.addEventListener('click', () => {
        const open = toggle.getAttribute('aria-expanded') === 'true';
        toggle.setAttribute('aria-expanded', String(!open));
        panel?.toggleAttribute('hidden', open);
    });

    panel?.addEventListener('click', (event) => {
        if ((event.target as HTMLElement).tagName === 'A') closeMenu();
    });

    document.addEventListener('keydown', (event) => {
        if (event.key === 'Escape' && toggle?.getAttribute('aria-expanded') === 'true') {
            closeMenu();
            toggle.focus();
        }
    });

    const themeIcons = document.querySelectorAll('#theme-toggle-icon, #theme-toggle-icon-mobile');
    const syncIcons = () => {
        const isDark = document.documentElement.getAttribute('data-theme') === 'dark';
        themeIcons.forEach((icon) => {
            icon.textContent = isDark ? '◑' : '◐';
        });
    };
    syncIcons();

    const toggleTheme = () => {
        const next = document.documentElement.getAttribute('data-theme') === 'dark' ? 'light' : 'dark';
        document.documentElement.setAttribute('data-theme', next);
        localStorage.setItem('theme', next);
        syncIcons();
    };

    document.getElementById('theme-toggle')?.addEventListener('click', toggleTheme);
    document.getElementById('theme-toggle-mobile')?.addEventListener('click', toggleTheme);
</script>
