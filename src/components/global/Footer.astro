---
const repo = 'https://github.com/PEI-aLinha/';
---

<footer class="mt-auto border-t border-line">
    <div class="shell flex flex-col gap-8 py-14 sm:flex-row sm:items-start sm:gap-16">
        <div class="flex-1">
            <p class="font-display text-[1.0625rem] font-semibold tracking-[-0.03em]">aLinha</p>
            <p class="meta mt-2.5">Projeto em Engenharia Informática</p>
        </div>
        <div>
            <p class="meta">Universidade de Aveiro</p>
            <p class="meta mt-2">2026/2027</p>
        </div>
        <a href={repo} rel="noopener noreferrer" target="_blank" class="axis-link meta meta-on inline-flex">
            GitHub ↗
        </a>
    </div>
</footer>