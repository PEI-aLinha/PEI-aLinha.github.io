---
import Logo from '../ui/Logo.astro';
import AlignmentMark from '../brand/AlignmentMark.astro';
import { url } from '../../lib/paths';

const repo = 'https://github.com/PEI-aLinha/';
const advisors = ['João Almeida', 'Daniel Ferreira'];
const secondaryLinks = [
    { label: 'Progress', href: '/milestones' },
    { label: 'Minutes', href: '/minutes' },
    { label: 'Documentation', href: '/documentation' },
];

const supporters = [
    { name: 'Universidade de Aveiro', src: '/images/logos/ua.png', width: 345, href: 'https://www.ua.pt' },
    { name: 'IEETA', src: '/images/logos/ieeta.png', width: 287, href: 'https://www.ieeta.pt' },
    { name: 'LASI — Laboratório Associado de Sistemas Inteligentes', src: '/images/logos/lasi.png', width: 192 },
    { name: 'AETTUA — Associação de Eletrónica, Telecomunicações e Telemática da UA', src: '/images/logos/aettua.png', width: 486 },
];
---

<footer
        class="footer-map relative mt-auto overflow-hidden border-t border-line"
        style={`--map-light: url(${url('/images/footer/map-light.webp')}); --map-dark: url(${url('/images/footer/map-dark.png')});`}
>
    <div class="shell relative flex flex-wrap items-center justify-between gap-8 py-10 border-b border-line">
        <ul class="flex flex-wrap items-center gap-x-12 gap-y-6">
            {
                supporters.map((s) => {
                    const Tag = s.href ? 'a' : 'span';
                    return (
                        <li>
                            <Tag
                                    href={s.href}
                                    rel={s.href ? 'noopener noreferrer' : undefined}
                                    target={s.href ? '_blank' : undefined}
                                    class="block opacity-85 transition-opacity duration-300 hover:opacity-100"
                            >
                                <img
                                        src={url(s.src)}
                                        alt={s.name}
                                        width={s.width}
                                        height="128"
                                        loading="lazy"
                                        class="h-9 w-auto md:h-11"
                                />
                            </Tag>
                        </li>
                    );
                })
            }
        </ul>
        <a
                href={repo}
                rel="noopener noreferrer"
                target="_blank"
                aria-label="GitHub — opens in a new tab"
                class="flex h-9 w-9 items-center justify-center border border-line text-text opacity-85 transition-opacity duration-300 hover:opacity-100"
        >
            <svg viewBox="0 0 24 24" class="h-5 w-5" fill="currentColor" aria-hidden="true">
                <path d="M12 .5C5.65.5.5 5.65.5 12c0 5.09 3.29 9.4 7.86 10.93.57.1.78-.25.78-.55 0-.27-.01-1.17-.02-2.12-3.2.7-3.88-1.36-3.88-1.36-.52-1.34-1.28-1.69-1.28-1.69-1.05-.72.08-.7.08-.7 1.16.08 1.77 1.19 1.77 1.19 1.03 1.77 2.7 1.26 3.36.96.1-.75.4-1.26.73-1.55-2.55-.29-5.24-1.28-5.24-5.69 0-1.26.45-2.28 1.19-3.09-.12-.29-.52-1.47.11-3.06 0 0 .97-.31 3.18 1.18a11.03 11.03 0 0 1 5.8 0c2.2-1.49 3.17-1.18 3.17-1.18.64 1.59.24 2.77.12 3.06.74.81 1.18 1.83 1.18 3.09 0 4.42-2.69 5.39-5.25 5.68.41.36.78 1.06.78 2.14 0 1.55-.01 2.79-.01 3.17 0 .3.2.66.79.55A10.52 10.52 0 0 0 23.5 12c0-6.35-5.15-11.5-11.5-11.5Z" />
            </svg>
        </a>
    </div>
    <div class="pointer-events-none absolute -right-10 -bottom-16 opacity-[0.06]" aria-hidden="true">
        <AlignmentMark variant="compact" class="h-[220px] w-[220px]" />
    </div>

    <div class="shell relative grid gap-10 py-14 sm:grid-cols-2 lg:grid-cols-[minmax(0,1.4fr)_1fr_1fr_1fr] lg:gap-16">
        <div>
            <Logo class="text-2xl text-brand md:text-[2rem]" />
            <p class="meta mt-2.5">CISO-as-a-Service for SMEs</p>
        </div>
        <div>
            <p class="meta meta-on">Universidade de Aveiro</p>
            <p class="meta mt-2">DETI · Projeto em Engenharia Informática</p>
            <p class="meta mt-2">2026/2027</p>
        </div>
        <div>
            <p class="meta meta-on">Advisors</p>
            {advisors.map((name) => <p class="meta mt-2">{name}</p>)}
        </div>
        <div class="flex flex-col items-start gap-2.5">
            {secondaryLinks.map((link) => (
                <a href={url(link.href)} class="axis-link meta">{link.label}</a>
            ))}
        </div>
    </div>
</footer>

<style>
    .footer-map {
        background-image: var(--map-light);
        background-size: cover;
        background-position: center;
        background-repeat: no-repeat;
    }

    :root[data-theme='dark'] .footer-map {
        background-image: var(--map-dark);
    }

    @media (prefers-color-scheme: dark) {
        :root:not([data-theme='light']) .footer-map {
            background-image: var(--map-dark);
        }
    }

    .footer-map::before {
        content: '';
        position: absolute;
        inset: 0;
        background: color-mix(in oklab, var(--color-brand) 35%, transparent);
        mix-blend-mode: multiply;
        pointer-events: none;
    }

    :root[data-theme='dark'] .footer-map::before,
    :root:not([data-theme='light']) .footer-map::before {
        mix-blend-mode: screen;
        background: color-mix(in oklab, var(--color-brand) 25%, transparent);
    }

    .footer-map > .shell {
        position: relative;
        isolation: isolate;
    }

    .footer-map > .shell::before {
        content: '';
        position: absolute;
        top: 0;
        bottom: 0;
        left: 50%;
        width: 100vw;
        transform: translateX(-50%);
        background-color: var(--color-background);
        opacity: 0.55;
        z-index: -1;
    }
</style>
