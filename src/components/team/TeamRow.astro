---
import type { CollectionEntry } from "astro:content";

interface Props {
    entry: CollectionEntry<'team'>
}

const { entry } = Astro.props;
const { name, initials, image, imageAlt, role, focus, github, linkedin } = entry.data;
---
<li
        data-reveal
        class="group flex min-w-0 flex-col border-t border-line pt-4 first:border-text"
>
    <div class="relative aspect-[4/5] overflow-hidden bg-surface">
        {
            image ? (
                    <img
                            src={image}
                            alt={imageAlt ?? `Portrait of ${name}`}
                            class="h-full w-full object-cover grayscale transition duration-500 group-hover:scale-[1.02] group-hover:grayscale-0"
                            loading="lazy"
                    />
            ) : (
                    <div class="flex h-full w-full items-center justify-center" aria-hidden="true">
          <span class="font-display text-[clamp(3.5rem,8vw,6.5rem)] font-medium tracking-[-0.06em] text-line-soft transition-colors duration-300 group-hover:text-muted">
            {initials}
          </span>
                    </div>
            )
        }
        <span class="absolute bottom-0 left-0 bg-background px-3 py-2 font-mono text-[0.6875rem] tracking-[0.14em] text-muted uppercase">
      {String(entry.data.order).padStart(2, '0')}
    </span>
    </div>

    <div class="flex flex-1 flex-col pt-5">
        <h2 class="font-display text-[clamp(1.75rem,3vw,2.5rem)] font-medium leading-[1.05] tracking-[-0.035em]">{name}</h2>
        <p class="meta mt-3">{role}</p>

        {focus && <p class="mt-5 max-w-[34rem] text-sm leading-[1.7] text-muted">{focus}</p>}

        <div class="mt-auto flex gap-6 pt-6">
            {
                github && (
                            <a href={github} rel="noopener noreferrer" target="_blank" class="axis-link meta meta-on inline-flex min-h-11 items-center">
                                GitHub ↗
                            </a>
                )
            }
            {
                linkedin && (
                            <a href={linkedin} rel="noopener noreferrer" target="_blank" class="axis-link meta meta-on inline-flex min-h-11 items-center">
                                LinkedIn ↗
                            </a>
                )
            }
        </div>
    </div>
</li>
