---
interface Props {
    /** Section number shown in the rail, e.g. "01". */
    number?: string;
    label?: string;
    title?: string;
    id?: string;
}
const { number, label, title, id } = Astro.props;
---
<p class="meta">
    {number && <span class="meta-on">§ {number}</span>}
    {number && label && ' · '}
    {label}
</p>
{
    title && (
    <h2
            id={id}
            data-reveal
            class="mt-5 max-w-4xl font-display font-medium tracking-[-0.03em]"
            style="font-size: var(--text-section); line-height: 1.12;"
    >
        {title}
    </h2>
        )
    }
