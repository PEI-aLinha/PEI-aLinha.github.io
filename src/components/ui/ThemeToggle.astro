<button type="button" class="theme-toggle" aria-label="Switch to dark mode" title="Switch to dark mode">
  <svg viewBox="0 0 32 44" width="32" height="44" aria-hidden="true">
    <g class="axis-mark">
      <line class="axis-segment axis-segment--top" x1="7" y1="7" x2="16" y2="7" />
      <line class="axis-segment axis-segment--middle" x1="16" y1="12" x2="26" y2="12" />
      <line class="axis-segment axis-segment--bottom" x1="10" y1="17" x2="16" y2="17" />
      <line class="axis-spine" x1="16" y1="4" x2="16" y2="22" />
      <circle class="axis-signal" cx="16" cy="12" r="3" />
      <circle class="axis-halo" cx="16" cy="12" r="6" />
    </g>
    <line class="toggle-stem" x1="16" y1="22" x2="16" y2="34" />
    <circle class="toggle-handle" cx="16" cy="35" r="3" />
  </svg>
</button>

<style>
  .theme-toggle {
    display: flex;
    width: 2rem;
    height: 2.75rem;
    align-items: center;
    justify-content: center;
    padding: 0;
    cursor: pointer;
    user-select: none;
    touch-action: none;
    color: currentColor;
    background: transparent;
    border: 0;
  }

  .theme-toggle svg { overflow: visible; }
  .axis-segment,
  .axis-spine,
  .toggle-stem {
    fill: none;
    stroke: currentColor;
    stroke-linecap: square;
  }
  .axis-segment { stroke-width: 1.25; transition: transform 380ms var(--ease-align), opacity 240ms ease; }
  .axis-spine { stroke-width: 1; opacity: .38; }
  .axis-signal {
    fill: var(--color-silver);
    stroke: currentColor;
    stroke-width: 1;
    transition: fill 300ms ease, transform 420ms var(--ease-align);
    transform-box: fill-box;
    transform-origin: center;
  }
  .axis-halo {
    fill: none;
    stroke: var(--color-signal);
    stroke-width: 1;
    opacity: 0;
    transform: scale(.65);
    transform-box: fill-box;
    transform-origin: center;
    transition: opacity 300ms ease, transform 420ms var(--ease-align);
  }
  .toggle-stem {
    stroke-width: 1.25;
    opacity: .68;
    transform-box: fill-box;
    transform-origin: top center;
  }
  .toggle-handle {
    fill: var(--color-background);
    stroke: currentColor;
    stroke-width: 1.25;
    cursor: grab;
    transition: fill 300ms ease;
  }
  .theme-toggle[data-dragging] .toggle-handle { cursor: grabbing; }

  :global(:root:not([data-theme='dark'])) .axis-segment--top { transform: translateX(2px); }
  :global(:root:not([data-theme='dark'])) .axis-segment--middle { transform: translateX(-2px); }
  :global(:root:not([data-theme='dark'])) .axis-signal {
    fill: var(--color-signal);
    transform: scale(.82);
  }
  :global(:root:not([data-theme='dark'])) .axis-halo {
    opacity: .55;
    transform: scale(1);
  }
  :global(:root:not([data-theme='dark'])) .toggle-handle { fill: var(--color-signal); }

  @media (prefers-reduced-motion: reduce) {
    .axis-segment,
    .axis-signal,
    .axis-halo,
    .toggle-handle { transition: none; }
  }
</style>

<script>
  const setupThemeToggle = (button: HTMLButtonElement) => {
    if (button.dataset.ready) return;
    button.dataset.ready = 'true';

    const stem = button.querySelector<SVGLineElement>('.toggle-stem');
    const handle = button.querySelector<SVGCircleElement>('.toggle-handle');
    let dragging = false;
    let startY = 0;
    let distance = 0;
    let suppressClick = false;

    const sync = () => {
      const dark = document.documentElement.dataset.theme === 'dark';
      const label = dark ? 'Switch to light mode' : 'Switch to dark mode';
      button.setAttribute('aria-label', label);
      button.title = label;
    };

    const changeTheme = (x: number, y: number) => {
      const root = document.documentElement;
      if (root.dataset.themeTransitioning !== undefined) return;

      const next = root.dataset.theme === 'dark' ? 'light' : 'dark';
      root.style.setProperty('--reveal-x', `${x}px`);
      root.style.setProperty('--reveal-y', `${y}px`);

      const apply = () => {
        root.dataset.theme = next;
        localStorage.setItem('theme', next);
        document.querySelectorAll<HTMLButtonElement>('.theme-toggle').forEach((item) => {
          const label = next === 'dark' ? 'Switch to light mode' : 'Switch to dark mode';
          item.setAttribute('aria-label', label);
          item.title = label;
        });
      };

      if (document.startViewTransition && !window.matchMedia('(prefers-reduced-motion: reduce)').matches) {
        root.dataset.themeTransitioning = '';
        try {
          const transition = document.startViewTransition(apply);
          const clear = () => delete root.dataset.themeTransitioning;
          transition.finished.finally(clear);
          setTimeout(clear, 1000);
        } catch {
          delete root.dataset.themeTransitioning;
          apply();
        }
      } else {
        apply();
      }
    };

    const resetHandle = () => {
      if (!stem || !handle) return;
      const options: KeyframeAnimationOptions = {
        duration: 450,
        easing: 'cubic-bezier(.2, 1.8, .4, 1)',
        fill: 'forwards',
      };
      stem.animate([{ transform: `scaleY(${1 + distance / 10})` }, { transform: 'scaleY(1)' }], options);
      handle.animate([{ transform: `translateY(${distance}px)` }, { transform: 'translateY(0)' }], options);
      stem.style.transform = '';
      handle.style.transform = '';
    };

    handle?.addEventListener('pointerdown', (event) => {
      event.preventDefault();
      dragging = true;
      startY = event.clientY;
      distance = 0;
      button.dataset.dragging = '';
      handle.setPointerCapture(event.pointerId);
    });

    handle?.addEventListener('pointermove', (event) => {
      if (!dragging || !stem || !handle) return;
      distance = Math.max(0, Math.min(event.clientY - startY, 16));
      stem.style.transform = `scaleY(${1 + distance / 10})`;
      handle.style.transform = `translateY(${distance}px)`;
    });

    handle?.addEventListener('pointerup', (event) => {
      if (!dragging) return;
      dragging = false;
      delete button.dataset.dragging;
      resetHandle();
      if (distance > 8) {
        suppressClick = true;
        const rect = button.getBoundingClientRect();
        changeTheme(rect.left + rect.width / 2, rect.top + rect.height / 2);
      }
      handle.releasePointerCapture(event.pointerId);
    });

    button.addEventListener('click', (event) => {
      if (suppressClick) {
        suppressClick = false;
        return;
      }
      changeTheme(
        event.clientX || button.getBoundingClientRect().left + button.offsetWidth / 2,
        event.clientY || button.getBoundingClientRect().top + button.offsetHeight / 2,
      );
    });

    sync();
  };

  document.querySelectorAll<HTMLButtonElement>('.theme-toggle').forEach(setupThemeToggle);
</script>
