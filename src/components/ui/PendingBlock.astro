---
interface Props {
    when: string;
}

const { when } = Astro.props;
const fragments = [64, 32, 96, 24];
---

<div class="max-w-2xl border border-line bg-surface p-6 sm:p-8">
    <p class="meta meta-on">Pending - {when}</p>
    <p class="mt-3.5 text-base leading-relaxed text-muted"><slot /></p>
    <div class="mt-7 flex gap-2" aria-hidden="true">
        {fragments.map((w) => <span class="block h-px bg-line-soft" style={{ width: `${w}px` }} />)}
    </div>
</div>
