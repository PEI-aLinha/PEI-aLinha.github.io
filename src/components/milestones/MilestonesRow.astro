---
import type { CollectionEntry } from 'astro:content';
import StatusDot from '../ui/StatusDot.astro';
import { url } from '../../lib/paths';

interface Props {
    entry: CollectionEntry<'milestones'>;
    first?: boolean;
    last?: boolean;
}

const { entry, first = false, last = false } = Astro.props;
const { number, title, status, start, end, summary, deliverables } = entry.data;

const monthYear = (d: Date) => d.toLocaleDateString('en-GB', { month: 'short', year: 'numeric' });
const padded = String(number).padStart(2, '0');
---
<a
        href={url(`/milestones/${entry.id}`)}
        data-reveal
        class:list={[
            '-mx-6 grid gap-4 px-6 py-9 transition-colors duration-300 hover:bg-surface md:grid-cols-[120px_minmax(0,1fr)_160px] md:gap-10',
            first ? 'border-t border-text' : 'border-t border-line',
            last && 'border-b border-line',
        ]}
>
    <p class:list={['meta', status !== 'planned' && 'meta-on text-brand']}>Phase {padded}</p>

    <div>
        <p
                class:list={[
                    'font-display text-2xl font-medium tracking-[-0.025em]',
                    status === 'planned' && 'text-muted',
                ]}
        >
            {title}
        </p>
        <p class="mt-3 max-w-2xl text-base leading-[1.55] text-muted">{summary}</p>
        {deliverables.length > 0 && <p class="meta mt-4">{deliverables.length} deliverables</p>}
    </div>

    <div class="flex flex-col gap-3 md:items-end">
        <StatusDot status={status} />
        <p class="meta">{monthYear(start)} — {monthYear(end)}</p>
    </div>
</a>
