---
import SectionHeader from "../ui/SectionHeader.astro"

/* Numbered rows separated by rules - not feature cards. The number carries
the sequence, the rule carries the separation, nothing is boxed. */

const steps = [
    {
        number: '01',
        title: 'Understand',
        body: 'Build a working picture of the organisation: its systems, assets, infrastructure and the security context it actually operates in.',
    },
    {
        number: '02',
        title: 'Assess',
        body: 'Map that picture against security and compliance requirements, and surface where the gaps genuinely are.',
    },
    {
        number: '03',
        title: 'Guide',
        body: 'Turn gaps into recommendations a team can act on, prioritised by what the organisation can realistically move first.',
    },
    {
        number: '04',
        title: 'Evolve',
        body: 'Keep the posture current as the organisation changes and requirements change with it. Compliance as a state, not an event.',
    },
];
---

<section aria-labelledby="capabilities-heading" class="shell rail-grid border-t border-line py-[var(--space-section)]">
    <div>
        <SectionHeader number="03" label="What aLinha does" />
        <h2 id="capabilities-heading" class="sr-only">What aLinha does</h2>
    </div>

    <div class="flex flex-col">
        {
            steps.map((step, i) => (
                    <div
                            class:list={[
                                'grid gap-4 py-10 md:grid-cols-[300px_minmax(0,1fr)] md:gap-12',
                                i === 0 ? 'border-t-0 pt-0 md:pt-0' : 'border-t border-line',
                            ]}
                            data-reveal
                    >
                        <p class="meta meta-on">
                            {step.number} — {step.title}
                        </p>
                        <p class="max-w-lg text-xl leading-[1.5]">{step.body}</p>
                    </div>
            ))
        }
    </div>
</section>

