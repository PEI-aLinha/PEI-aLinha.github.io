---
import LinkArrow from '../ui/LinkArrow.astro';
import { url } from '../../lib/paths';

const frameworks = ['NIS2', 'GDPR', 'EU AI Act', 'SOC-CMM'];
---
<section aria-labelledby="intro-heading" class="hero shell grid min-h-[620px] items-center gap-14 py-14 md:grid-cols-[minmax(0,1.02fr)_minmax(340px,.98fr)] md:gap-[7vw] md:py-20">
  <div>
    <h1 id="intro-heading" data-reveal class="max-w-4xl font-display font-semibold tracking-[-0.065em]" style="font-size:var(--text-hero);line-height:.9">
      Everything<br /><span class="text-brand">aligned.</span>
    </h1>
    <p class="mt-8 max-w-2xl leading-[1.6] text-text-soft" style="font-size:var(--text-lead)" data-reveal>
      aLinha is a CISO-as-a-Service platform designed to support cybersecurity compliance workflows for Portuguese SMEs.
    </p>

    <div class="mt-8 flex flex-wrap gap-x-9 gap-y-4">
      <LinkArrow href={url('/project')}>Read about the project</LinkArrow>
      <LinkArrow href={url('/documentation')}>Documentation</LinkArrow>
    </div>

    <ul class="mt-9 flex flex-wrap gap-x-6 gap-y-2" aria-label="Frameworks and references">
      {frameworks.map((name) => <li class="meta meta-on">{name}</li>)}
    </ul>
  </div>

  <figure class="hero-shot relative">
    <img src={url('/preview-product.png')} width="1440" height="900" alt="The consultant's client portfolio in aLinha: twelve SMEs, each with its phase and next step." class="block w-full border border-line" loading="eager" fetchpriority="high" />
    <figcaption class="meta mt-3 text-text-soft">Consultant view · client portfolio (prototype)</figcaption>
  </figure>
</section>

<style>
  .hero { position:relative; }
  .hero-shot img { border-radius: 10px; box-shadow: 0 1px 0 var(--color-line), 0 24px 48px -24px rgb(0 0 0 / .25); }
</style>
