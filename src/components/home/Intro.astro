---
import LinkArrow from '../ui/LinkArrow.astro';
import AlignmentField from '../brand/AlignmentField.astro';
import { url } from '../../lib/paths';

const frameworks = ['NIS2', 'GDPR', 'EU AI Act', 'SOC-CMM'];
---
<section aria-labelledby="intro-heading" class="relative overflow-hidden pt-14 pb-[var(--space-section)] md:pt-20">
    <div class="shell flex items-baseline justify-between">
        <p class="meta">CISO-as-a-Service</p>
        <p class="meta">2026/27</p>
    </div>

    <div class="relative mt-10 grid gap-4 md:grid-cols-[1fr_minmax(0,34%)] md:items-stretch md:gap-0">
        <h1
                id="intro-heading"
                data-reveal
                class="shell max-w-4xl font-display font-semibold tracking-[-0.05em] md:pr-10"
                style="font-size: var(--text-hero); line-height: 0.92;"
        >
            Everything<br />
            <span class="text-brand">aligned.</span>
        </h1>

        <div class="relative min-h-[220px] bg-brand px-8 py-10 text-white md:min-h-0">
            <AlignmentField variant="hero" class="max-w-[280px] [--color-signal:var(--color-signal)] [--color-text:#fff] [--color-brand:#fff]" />
        </div>
    </div>

    <div class="shell mt-10">
        <p class="max-w-3xl leading-[1.45]" style="font-size: var(--text-lead);" data-reveal>
            We are building a CISO-as-a-Service platform to help Portuguese SMEs understand, organise
            and manage cybersecurity compliance.
        </p>

        <p class="meta mt-5">Projeto em Engenharia Informática · Universidade de Aveiro · 2026/27</p>

        <div class="mt-10 flex flex-col gap-8 md:flex-row md:items-center md:gap-14">
            <ul class="flex flex-wrap gap-x-6 gap-y-2" aria-label="Regulatory frameworks covered">
                {frameworks.map((name) => <li class="meta meta-on">{name}</li>)}
            </ul>
            <div class="flex gap-8 md:ml-auto">
                <LinkArrow href={url('/project')}>The project</LinkArrow>
                <LinkArrow href={url('/team')}>The team</LinkArrow>
            </div>
        </div>
    </div>
</section>
