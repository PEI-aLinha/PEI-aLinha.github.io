---
import LinkArrow from '../ui/LinkArrow.astro';
import AlignmentField from '../brand/AlignmentField.astro';
import { url } from '../../lib/paths';

const frameworks = ['NIS2', 'GDPR', 'EU AI Act', 'SOC-CMM'];
---
<section aria-labelledby="intro-heading" class="shell grid min-h-[620px] items-center gap-14 py-14 md:grid-cols-[minmax(0,1.02fr)_minmax(340px,.98fr)] md:gap-[7vw] md:py-20">
  <div>
    <p class="meta text-signal">CISO-as-a-Service · PEI 2026/27</p>
    <h1 id="intro-heading" data-reveal class="mt-4 max-w-4xl font-display font-semibold tracking-[-0.065em]" style="font-size:var(--text-hero);line-height:.9">
      Everything<br /><span class="text-brand">aligned.</span>
    </h1>
    <p class="mt-8 max-w-2xl leading-[1.6] text-text-soft" style="font-size:var(--text-lead)" data-reveal>
      aLinha is a CISO-as-a-Service platform designed to support cybersecurity compliance workflows for Portuguese SMEs.
    </p>

    <div class="mt-8 flex flex-wrap gap-x-9 gap-y-4">
      <LinkArrow href={url('/project')}>Discover the project</LinkArrow>
      <LinkArrow href={url('/documentation')}>Documentation</LinkArrow>
    </div>

    <ul class="mt-9 flex flex-wrap gap-x-6 gap-y-2" aria-label="Frameworks and references">
      {frameworks.map((name) => <li class="meta meta-on">{name}</li>)}
    </ul>
  </div>

  <div class="relative min-h-[330px] overflow-hidden bg-brand md:min-h-[390px]" aria-hidden="true">
    <p class="meta absolute left-7 top-7 z-10 text-white/60">Misaligned → aligned</p>
    <div class="absolute inset-x-5 top-16 md:inset-x-8 md:top-14">
      <AlignmentField variant="hero" class="h-full w-full [--color-brand:#FFFFFF] [--color-text:#FFFFFF] [--color-signal:var(--color-signal)]" />
    </div>
  </div>
</section>
