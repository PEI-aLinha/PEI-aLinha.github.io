---
const problems = [
    {
        number: '01',
        title: 'Fragmented context',
        body: 'Assets, systems, policies and evidence live in different places, making it difficult to build a reliable view of the organisation.',
    },
    {
        number: '02',
        title: 'Point-in-time compliance',
        body: 'Assessments capture a moment, but the organisation and its requirements continue to change as soon as the review is complete.',
    },
    {
        number: '03',
        title: 'Unclear priorities',
        body: 'Findings are rarely connected to the organisation’s real constraints, leaving teams without a practical order for what to improve first.',
    },
];
---

<section aria-labelledby="problems-heading" class="shell rail-grid border-t border-line py-[var(--space-section)]">
    <div>
        <p class="meta">01 — The problem</p>
    </div>

    <div>
        <h2
            id="problems-heading"
            data-reveal
            class="mb-12 max-w-3xl font-display font-medium tracking-[-0.03em] md:mb-16"
            style="font-size: var(--text-section); line-height: 1.12;"
        >
            Security information exists. Alignment does not.
        </h2>

        <div class="flex flex-col">
        {
            problems.map((problem) => (
                <div
                    class="grid gap-4 border-t border-line py-10 md:grid-cols-[300px_minmax(0,1fr)] md:gap-12"
                    data-reveal
                >
                    <p class="meta meta-on">
                        {problem.number} — {problem.title}
                    </p>
                    <p class="max-w-lg text-xl leading-[1.5]">{problem.body}</p>
                </div>
            ))
        }
        </div>
    </div>
</section>
