---
import SectionHeader from "../ui/SectionHeader.astro"
import AlignDiagram from "./AlignDiagram.astro"
---

<section aria-labelledby="approach-heading" class="shell rail-grid border-t border-line py-[var(--space-section)]">
    <div><SectionHeader number="02" label="The approach" /></div>

    <div>
        <h2
            id="approach-heading"
            data-reveal
            class="mb-14 max-w-2xl font-display font-medium tracking-[-0.03em]"
            style="font-size: var(--text-section); line-height: 1.12;"
        >
            From complexity to alignment.
        </h2>

        <AlignDiagram variant="wide" />
        <AlignDiagram variant="spine" />

        <p class="mt-11 max-w-xl text-[1.0625rem] leading-relaxed text-muted">
            One model of the organisation, one axis everythinh is measured against. The inputs stay where they live;
            what changes is that they finally line up.
        </p>
    </div>
</section>
