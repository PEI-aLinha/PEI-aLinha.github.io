---
import SectionHeader from '../ui/SectionHeader.astro';
---

<section aria-labelledby="why-heading" class="shell rail-grid border-t border-line py-[var(--space-section)]">
    <div><SectionHeader number="01" label="Why" /></div>

    <div>
        <h2
            id="why-heading"
            data-reveal
            class="mb-8 max-w-3xl font-display font-medium tracking-[-0.03em]"
            style="font-size: var(--text-section); line-height: 1.12;"
        >
            Why aLinha?
        </h2>

        <p class="max-w-2xl text-xl leading-[1.5]" data-reveal>
            Cybersecurity compliance can require specialised knowledge, continuous evidence
            management and significant resources. For smaller organisations, keeping everything
            aligned can quickly become difficult.
        </p>
    </div>
</section>
