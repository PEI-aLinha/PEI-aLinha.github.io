---
import { getCollection } from 'astro:content';
import BaseLayout from '../components/layouts/BaseLayout.astro';
import PageHeader from '../components/global/PageHeader.astro';
import TeamRow from '../components/team/TeamRow.astro';

const team = (await getCollection('team')).sort((a, b) => a.data.order - b.data.order);
---
<BaseLayout title="Team" description="The people building aLinha.">
  <PageHeader
    label={`${team.length} people`}
    title="Team"
    lead="Meet the people designing and building aLinha."
  />

  <div class="shell pb-24">
    <ul class="grid min-w-0 grid-cols-1 gap-x-5 gap-y-14 sm:grid-cols-2 lg:grid-cols-3 xl:grid-cols-5">
      {team.map((entry) => <TeamRow entry={entry} />)}
    </ul>

    <div class="mt-14 flex min-w-0 flex-col gap-10 md:flex-row md:gap-24">
      <div class="min-w-0">
        <p class="meta">Supervision</p>
        <p class="mt-3.5 text-lg">[SUPERVISOR NAME]</p>
        <p class="meta mt-2 break-words">Departamento de Eletrónica, Telecomunicações e Informática</p>
      </div>

    </div>
  </div>
</BaseLayout>
