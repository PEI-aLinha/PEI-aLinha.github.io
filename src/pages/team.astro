---
import { getCollection } from 'astro:content';
import BaseLayout from '../components/layouts/BaseLayout.astro';
import PageHeader from '../components/global/PageHeader.astro';
import TeamRow from '../components/team/TeamRow.astro';

const people = (await getCollection('team')).sort((a, b) => a.data.order - b.data.order);
const students = people.filter((p) => p.data.group === 'student');

const supervision = [
  { label: 'Advisors', entries: people.filter((p) => p.data.group === 'advisor') },
  { label: 'Collaborators', entries: people.filter((p) => p.data.group === 'collaborator') },
].filter((section) => section.entries.length > 0);
---
<BaseLayout title="Team" description="The students, advisors and collaborators behind aLinha.">
  <PageHeader
    label={`${students.length} students`}
    title="Team"
    lead="Meet the people designing and building aLinha, and those guiding it."
  />

  <div class="shell pb-24">
    <ul class="grid min-w-0 grid-cols-1 gap-x-5 gap-y-14 sm:grid-cols-2 lg:grid-cols-3 xl:grid-cols-5">
      {students.map((entry) => <TeamRow entry={entry} />)}
    </ul>

    <div class="mt-24 grid min-w-0 gap-14 md:grid-cols-2 md:gap-20">
      {
        supervision.map((section) => (
          <section aria-labelledby={`${section.label.toLowerCase()}-heading`}>
            <h2 id={`${section.label.toLowerCase()}-heading`} class="meta meta-on mb-1">
              {section.label}
            </h2>
            <ul>
              {section.entries.map(({ data }) => (
                <li data-reveal class="border-t border-line py-5 last:border-b">
                  <p class="font-display text-2xl font-medium tracking-[-0.025em]">{data.name}</p>
                  <p class="meta mt-2.5 break-words">{data.role}</p>
                  {data.affiliation && <p class="meta mt-1.5 break-words">{data.affiliation}</p>}
                </li>
              ))}
            </ul>
          </section>
        ))
      }
    </div>
  </div>
</BaseLayout>
