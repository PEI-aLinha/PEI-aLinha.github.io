---
import BaseLayout from '../components/layouts/BaseLayout.astro';
import PendingBlock from '../components/ui/PendingBlock.astro';
import AlignmentField from '../components/brand/AlignmentField.astro';
import { url } from '../lib/paths';

const sections = [
  { id: 'project', number: '01', title: 'The project' },
  { id: 'building', number: '02', title: "What we're building" },
  { id: 'scope', number: '03', title: 'Scope' },
  { id: 'system', number: '04', title: 'How it works' },
];

const capabilities = [
  ['Client & entity management', 'Register client organisations, their sector, size, regulatory scope and designated responsible person.'],
  ['Maturity & gap assessment', 'Assess organisational maturity against SOC-CMM tiers, identify gaps and turn the results into a prioritised improvement roadmap.'],
  ['Policy & evidence management', 'Connect policies, requirements and supporting evidence so organisations can see what exists, what is missing and what still requires action.'],
  ['Incident reporting support', 'Workflow and drafting support for NIS2 notification obligations.'],
  ['Dashboard & indicators', 'Compliance coverage, open gaps and upcoming deadlines, for both provider and client.'],
];

const inScope = [
  'Client and entity management',
  'Maturity and gap assessment',
  'Policy and evidence management',
  'Incident reporting support',
  'Provider and client views',
  'AI-assisted workflows with human review',
];

const outOfScope = [
  'Acting as a certifying authority',
  'Replacing legal advice',
  'Fully autonomous client-facing decisions',
  'Live technical monitoring in the initial prototype',
];

const facts = [
  ['Course', 'Projeto em Engenharia Informática'],
  ['Institution', 'Universidade de Aveiro'],
  ['Year', '2026 / 2027'],
  ['Advisors', 'João Almeida · Daniel Ferreira'],
  ['Phase', 'Requirements & Planning'],
];
---
<BaseLayout
  title="Project"
  description="Building a CISO-as-a-Service platform for Portuguese SMEs — what aLinha is, what it does, and its scope."
>
  <div class="relative overflow-hidden bg-ink pt-16 pb-18 text-white md:pt-26">
    <div class="pointer-events-none absolute inset-y-0 right-0 hidden w-[36%] opacity-90 md:block">
      <AlignmentField variant="hero" class="h-full w-full [--color-signal:var(--color-signal)] [--color-text:#ffffff66] [--color-brand:var(--color-brand)]" />
    </div>
    <div class="shell relative">
      <p class="meta text-white/60">Project / 2026—27</p>
      <h1
        data-reveal
        class="mt-4 max-w-3xl font-display font-semibold tracking-[-0.045em]"
        style="font-size: var(--text-title); line-height: 1;"
      >
        Building a <span class="text-brand">CISO-as-a-Service</span> platform.
      </h1>

      <dl class="mt-10 flex flex-wrap gap-x-16 gap-y-6">
        {
          facts.map(([term, value]) => (
            <div>
              <dt class="meta text-white/50">{term}</dt>
              <dd class="mt-2 text-[0.9375rem] text-white/90">{value}</dd>
            </div>
          ))
        }
      </dl>
    </div>
  </div>

  <div class="shell rail-grid pb-26">
    <nav aria-label="Sections" class="self-start lg:sticky lg:top-10">
      <p class="meta mb-5">Contents</p>
      <ul class="flex flex-wrap gap-x-6 gap-y-3 md:flex-col">
        {
          sections.map((section) => (
            <li>
              <a href={`#${section.id}`} class="axis-link text-sm">
                {section.number} {section.title}
              </a>
            </li>
          ))
        }
      </ul>
    </nav>

    <div class="flex flex-col">
      <section id="project" aria-labelledby="h-project" class="scroll-mt-10 border-b border-line pb-16">
        <p class="meta">01</p>
        <h2 id="h-project" data-reveal class="mt-4.5 mb-6 font-display font-medium tracking-[-0.03em]" style="font-size: var(--text-sub);">
          The project
        </h2>
        <p class="mb-6 max-w-2xl text-xl leading-[1.5]">
          Cybersecurity compliance — under the NIS2 Directive, the GDPR and, increasingly, the EU
          AI Act — is difficult for organisations without a dedicated security officer. Most SMEs
          have no such role, no security budget and no in-house expertise to interpret what is
          required.
        </p>
        <p class="my-6 max-w-xl border-l-2 border-signal pl-5 font-display text-xl font-medium leading-[1.3] text-brand">
          A shared CISO, structured for organisations that could never afford one alone.
        </p>
        <div class="mt-4.5 grid gap-6 md:grid-cols-2">
          <p class="max-w-md text-base leading-[1.6] text-text-soft">
            aLinha explores how a shared CISO-as-a-Service model can reduce that operational burden.
            The platform is intended to support assessment, evidence management and incident-reporting
            workflows for a service provider working across several client organisations.
          </p>
          <p class="max-w-md text-base leading-[1.6] text-text-soft">
            AI is used to draft, prioritise and explain — it assists the workflow rather than replacing
            it. Accountability stays with the organisation's own designated person, and outputs are
            reviewed by people before they reach the client.
          </p>
        </div>
      </section>

      <section id="building" aria-labelledby="h-building" class="scroll-mt-10 border-b border-line py-16">
        <p class="meta">02</p>
        <h2 id="h-building" data-reveal class="mt-4.5 mb-6 font-display font-medium tracking-[-0.03em]" style="font-size: var(--text-sub);">
          What we're building
        </h2>
        <div class="max-w-3xl">
          {
            capabilities.map(([term, body], i) => (
              <div
                class:list={['flex flex-col gap-3 border-t border-line py-6 last:border-b', i % 2 === 1 && 'md:pl-16']}
                data-reveal
              >
                <div class="flex items-baseline gap-4">
                  <span class="meta text-brand">{String(i + 1).padStart(2, '0')}</span>
                  <p class="meta meta-on">{term}</p>
                </div>
                <p class="max-w-xl text-[1.0625rem] leading-[1.55] text-text-soft">{body}</p>
                <span
                  class="h-px bg-brand"
                  style={`width:${40 + i * 24}px`}
                  aria-hidden="true"
                ></span>
              </div>
            ))
          }
        </div>
        <p class="mt-8 max-w-2xl text-base leading-relaxed text-muted">
          Two user types: the <strong class="font-medium text-text">provider</strong>, who operates
          the service and reviews its outputs, and the <strong class="font-medium text-text">client</strong>,
          the organisation and its designated responsible person.
        </p>
      </section>

      <section id="scope" aria-labelledby="h-scope" class="scroll-mt-10 border-b border-line py-16">
        <p class="meta">03</p>
        <h2 id="h-scope" data-reveal class="mt-4.5 mb-6 font-display font-medium tracking-[-0.03em]" style="font-size: var(--text-sub);">
          Scope
        </h2>
        <div class="grid max-w-3xl gap-px border border-line bg-line md:grid-cols-2">
          <div class="bg-brand p-6 text-white sm:p-8">
            <p class="meta text-white/70">✓ In scope</p>
            <div class="mt-4 flex flex-col">
              {inScope.map((item) => <p class="border-t border-white/20 py-3.5 text-base first:border-t-0">{item}</p>)}
            </div>
          </div>
          <div class="bg-surface p-6 sm:p-8">
            <p class="meta">✕ Out of scope</p>
            <div class="mt-4 flex flex-col">
              {outOfScope.map((item) => <p class="border-t border-line py-3.5 text-base text-muted first:border-t-0">{item}</p>)}
            </div>
          </div>
        </div>
      </section>

      <section id="system" aria-labelledby="h-system" class="scroll-mt-10 pt-16">
        <p class="meta">04</p>
        <h2 id="h-system" data-reveal class="mt-4.5 mb-6 font-display font-medium tracking-[-0.03em]" style="font-size: var(--text-sub);">
          How it works
        </h2>
        <PendingBlock when="System Design · Nov 2026">
          The detailed architecture will be defined during System Design. It will cover the
          frontend, backend, data model, AI-service boundary, roles and permissions, and tenant
          isolation.
        </PendingBlock>
      </section>
    </div>
  </div>
</BaseLayout>
