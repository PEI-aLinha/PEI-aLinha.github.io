---
import { getCollection } from 'astro:content';
import BaseLayout from '../../components/layouts/BaseLayout.astro';
import PageHeader from '../../components/global/PageHeader.astro';
import LogRow from '../../components/minutes/LogRow.astro';

const minutes = (await getCollection('minutes')).sort((a, b) => b.data.index - a.data.index);
const logged = minutes.filter((m) => !m.data.scheduled);
const last = logged[0];
---
<BaseLayout title="Minutes" description="Meeting log for the aLinha project.">
  <PageHeader label="Meeting log" title="Minutes">
    <div class="mt-8 flex gap-16">
      <div>
        <p class="meta">Entries</p>
        <p class="mt-2 font-mono text-2xl">{String(logged.length).padStart(2, '0')}</p>
      </div>
      {
        last && (
          <div>
            <p class="meta">Last</p>
            <p class="mt-2 font-mono text-2xl">
              {last.data.date.toLocaleDateString('en-GB', { day: '2-digit', month: '2-digit', year: '2-digit' }).replace(/\//g, '.')}
            </p>
          </div>
        )
      }
    </div>
  </PageHeader>

  <div class="shell rail-grid pb-24">
    <div></div>
    <div>
      {minutes.map((entry, i) => <LogRow entry={entry} first={i === 0} />)}

      <div class="border-y border-line py-8">
        <div class="mb-5 flex items-center gap-2" aria-hidden="true">
          <span class="block h-px w-18 bg-line-soft"></span>
          <span class="block h-px w-7 bg-line-soft"></span>
          <span class="block h-px w-28 bg-line-soft"></span>
        </div>
        <p class="meta">Further entries appear here as they are written</p>
      </div>

      <div class="mt-10 flex items-center gap-6">
        <p class="meta">Adding a minute</p>
        <span class="h-px flex-1 bg-line" aria-hidden="true"></span>
        <code class="font-mono text-[0.8125rem] text-muted">src/content/minutes/2026-09-21.md</code>
      </div>
      <p class="mt-4.5 max-w-xl text-base leading-relaxed text-muted">
        A new entry is one Markdown file with date, number, subject and attendees in its
        frontmatter. This page is generated from the collection; nothing here is edited by hand.
      </p>
    </div>
  </div>
</BaseLayout>
